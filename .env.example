# Copy this file to .env and fill in your local values.
# The .env file is gitignored and should never be committed.

# Ollama
OLLAMA_API_BASE=http://localhost:11434

# Voting providers — comma-separated name:model pairs
# VOTING_PROVIDERS=qwen:ollama/qwen2.5:7b,llama:ollama/llama3.1:8b
# VOTING_PROVIDERS=qwen3-14b:ollama/qwen3:14b,gemini:gemini/gemini-2.0-flash,claude:claude-sonnet-4-6

# Provider API keys
# GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
