# Postgres (used by the db container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# Backend
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/app

# Frontend (base URL the browser uses to reach the backend)
VITE_API_URL=http://localhost:8000

# Ollama base URL.
# Use localhost when Ollama runs on the same machine.
# Use host.docker.internal when the backend runs in Docker and Ollama on the host.
OLLAMA_API_BASE=http://localhost:11434

# Vision model.
# LiteLLM model string for the vision model that reads text out of images.
VISION_MODEL=ollama/qwen2.5vl:7b

# Embedding model.
# Provider can be "local" (fastembed, no API needed) or "litellm" (any
# LiteLLM-supported embedding endpoint).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DIM=384
# For EMBEDDING_PROVIDER=litellm:
# EMBEDDING_MODEL=ollama/nomic-embed-text
# EMBEDDING_API_KEY=sk-...

# Voting models.
PROMETHEUS_MODEL=ollama/ggozad/prometheus2:latest
# Comma-separated list of name:model pairs. Each name becomes a voting provider.
#
# IMPORTANT: the voting layer reads VOTING_PROVIDERS with os.getenv, and nothing
# calls load_dotenv — so setting it HERE has no effect on a natively-run backend.
# It must be a real process environment variable, exported before uvicorn starts:
#   PowerShell   $env:VOTING_PROVIDERS = "claude:ollama/qwen2.5:7b"
#   bash         export VOTING_PROVIDERS="claude:ollama/qwen2.5:7b"
# Under Docker it does work from this file, because Compose interpolates it into
# the container environment. The built-in default already includes a `claude`
# entry, so leaving this unset is fine for local work.
#
# The name `claude` is required — app/services/scoring.py asks for it by name —
# but the model behind it is free choice. If no provider matches, every rubric
# degrades to 0.0 (a warning is logged; it is not a quality signal).
# VOTING_PROVIDERS=claude:ollama/qwen2.5:7b
# VOTING_PROVIDERS=claude:claude-sonnet-4-6            # cloud, needs ANTHROPIC_API_KEY
# VOTING_PROVIDERS=qwen3-14b:ollama/qwen3:14b,qwen3-27b:ollama/qwen3.8:27b,gemini:gemini/gemini-2.0-flash

# Provider API keys.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Ensemble generation layer ---
# Roster of generation agents (relative to the backend working directory).
# GENERATION_ROSTER_PATH=config/generation_agents.json
# Per-agent wall-clock limit in seconds.
# GENERATION_TIMEOUT_SECONDS=45
# Max criteria requested from each agent.
# GENERATION_MAX_CRITERIA=8
# RAG chunks injected into each agent prompt.
# RAG_TOP_K=5
# Set false to skip scoring while iterating on prompts.
# GENERATION_ENABLE_VOTING=true
