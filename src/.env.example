# Postgres (used by the db container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# Backend
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/app

# Frontend (base URL the browser uses to reach the backend)
VITE_API_URL=http://localhost:8000

# Later: LLM API key for the Pydantic AI agent pipeline
# LLM_API_KEY=
