# Postgres (used by the db container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

# Backend
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/app

# Frontend (base URL the browser uses to reach the backend)
VITE_API_URL=http://localhost:8000

# Later: LLM API key for the Pydantic AI agent pipeline
# LLM_API_KEY=

# Embedding model for the vector store.
# Provider can be "local", "ollama", or "api".
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Only read when EMBEDDING_PROVIDER is "ollama"
# OLLAMA_BASE_URL=http://localhost:11434

# Only read when EMBEDDING_PROVIDER is "api" 
# OpenAI, or an OpenAI-compatible endpoint.
# EMBEDDING_API_KEY=
# EMBEDDING_API_BASE_URL=
 

# Local Ollama vision model that reads text out of uploaded images during
# ingest. Must be a vision-capable model.
# OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Local Prometheus voting through Ollama
# Use localhost when the backend runs directly on the host.
# Use host.docker.internal when the backend runs in Docker and Ollama runs on the host.
OLLAMA_BASE_URL=http://localhost:11434
PROMETHEUS_MODEL=ggozad/prometheus2:latest