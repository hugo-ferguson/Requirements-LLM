# =============================================================================
# WHAT YOU NEED TO DO (from the src folder)
#
#   1. Copy this file to .env (same folder):
#        cp .env.example .env                  (PowerShell: Copy-Item .env.example .env)
#   2. Copy the model roster:
#        cp backend/config/generation_agents.example.json backend/config/generation_agents.json
#        (PowerShell: Copy-Item backend\config\generation_agents.example.json backend\config\generation_agents.json)
#   3. Fill in the two API keys directly below.
#
# That's it. Everything after the keys already works as-is — you don't need to
# read or change it. Never commit .env (it's gitignored).
# =============================================================================

# Anthropic: https://console.anthropic.com/  -> API Keys
ANTHROPIC_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=


# =============================================================================
# OPTIONAL — working defaults. Only change these if you know you need to.
# After any change here, run:  docker compose up -d --force-recreate backend
# =============================================================================


# -----------------------------------------------------------------------------
# Models
# -----------------------------------------------------------------------------
# Chat assistant, "Regenerate selected" and single-item refinement.
# Format: <provider>:<model>
LLM_MODEL=anthropic:claude-haiku-4-5-20251001

# Reads text out of uploaded images (PNG/JPG/...). PDFs and text files don't
# use it. Format: <provider>/<model>
VISION_MODEL=anthropic/claude-haiku-4-5-20251001

# Acceptance criteria and UAT test cases are written by EVERY enabled model in
# backend/config/generation_agents.json (Claude and OpenAI by default) — see the
# README. That file names the key variables above; it holds no keys itself.


# -----------------------------------------------------------------------------
# Scoring ("judges")
# -----------------------------------------------------------------------------
# Every candidate is scored 1-5 on four rubrics by each judge, and the judges'
# scores are averaged.
#
# VOTING_PROVIDERS defines the judges as name:model pairs. The name `claude`
# must always be present (the app asks for it by name).
VOTING_PROVIDERS=claude:anthropic/claude-haiku-4-5-20251001,luna:openai/gpt-6-luna
# Which of those judges actually score. Use `claude` alone to halve scoring cost.
VOTING_JUDGES=claude,luna


# -----------------------------------------------------------------------------
# Database and URLs
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/app

# Where the browser reaches the backend.
VITE_API_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# Document search
# -----------------------------------------------------------------------------
# Uploaded PDFs/text are split into chunks and embedded locally for retrieval.
# The model (~130 MB) is downloaded once, on the backend's first start, so that
# first start needs internet access. No API key is used.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384


# -----------------------------------------------------------------------------
# Tuning (uncomment to change; defaults shown)
# -----------------------------------------------------------------------------
# Max acceptance criteria requested from each model per generation.
# GENERATION_MAX_CRITERIA=8
# Seconds each model may take to answer before it is skipped.
# GENERATION_TIMEOUT_SECONDS=45
# Seconds each scoring request may take.
# VOTING_TIMEOUT_SECONDS=120
# Retrieved document chunks included in each generation prompt.
# RAG_TOP_K=5
# Skip scoring entirely (everything shows 0.0) — useful only when testing prompts.
# GENERATION_ENABLE_VOTING=true


# -----------------------------------------------------------------------------
# Local models via Ollama (not needed for Claude/OpenAI)
# -----------------------------------------------------------------------------
# Only if you switch a model above, or enable an Ollama entry in
# generation_agents.json. From inside Docker the host machine is
# host.docker.internal.
# OLLAMA_API_BASE=http://host.docker.internal:11434
# Example: VISION_MODEL=ollama/qwen2.5vl:7b
# Example: VOTING_PROVIDERS=claude:ollama/qwen2.5:7b
#
# Optional: Google Gemini instead of / alongside the above.
# GEMINI_API_KEY=
# Example: LLM_MODEL=google:gemini-3-flash-preview
